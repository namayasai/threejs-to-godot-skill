; Example 03: physics re-verification harness (Godot only). The helper scripts are copied to res://tg_port/ by run.sh.
config_version=5

[application]

config/name="example-03-physics-recheck"
config/features=PackedStringArray("4.7", "Forward Plus")

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0
common/physics_interpolation=false
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.8
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
